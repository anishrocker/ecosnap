# Mobile (Expo) — use EXPO_PUBLIC_ prefix
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Prefer publishable key (new Supabase projects); legacy anon still works:
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbG...   # optional fallback

# Admin (Next.js)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbG...   # optional fallback
# Supabase Dashboard → Authentication → URL Configuration:
# Add "http://localhost:3000/auth/callback" (and your production URL + /auth/callback) to Redirect URLs.
# Server-only: never expose to mobile / client bundles
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
